{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "development": true,
      "sprint*/**": true,
      "feature/**": true,
      "fix/**": true,
      "hotfix/**": true
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/uploads/:path*",
      "destination": "https://vitral-backend.onrender.com/api/v1/uploads/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
